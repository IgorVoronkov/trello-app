{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "react-perf",
    "unicorn",
    "import",
    "jsx-a11y",
    "oxc",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "settings": {
    "react": {
      "version": "19.2"
    }
  }
}
